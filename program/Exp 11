
import cv2
import numpy as np

img = cv2.imread("image.jpg")

if img is not None:
    h, w = img.shape[:2]
    matrix = cv2.getRotationMatrix2D((w // 2, h // 2), 180, 1)
    rotated = cv2.warpAffine(img, matrix, (w, h))
    cv2.imshow("Original Image", img)
    cv2.imshow("180 Degree Rotation", rotated)
    cv2.waitKey(0)
    cv2.destroyAllWindows()
