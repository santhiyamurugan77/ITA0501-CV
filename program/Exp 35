
import cv2

img = cv2.imread("image.jpg")

if img is not None:
    text = input("Enter text: ")

    cv2.putText(
        img, text, (50, 100),
        cv2.FONT_HERSHEY_SIMPLEX, 1,
        (0, 0, 255), 2, cv2.LINE_AA
    )

    cv2.imshow("Text on Image", img)
    cv2.waitKey(0)
    cv2.destroyAllWindows()
