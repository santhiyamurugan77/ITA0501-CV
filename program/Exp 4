import cv2

def analyze_histogram(image):
    colors = ('b', 'g', 'r')

    for i, color in enumerate(colors):
        hist = cv2.calcHist([image], [i], None, [256], [0, 256])
        print(color.upper(), "histogram values:", hist[:5].flatten())

img = cv2.imread("sample.jpg")

analyze_histogram(img)
